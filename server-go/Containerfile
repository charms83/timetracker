# Zeitprotokoll-Server – Image für OpenShift (Red Hat UBI, ohne Root, ohne Shell-Abhängigkeiten).
# Bauen aus dem Ordner server-go:   podman build -t zeitprotokoll-server:dev -f Containerfile .
# Das Programm ist statisch (kein CGO); die Admin-Oberfläche ist eingebettet. Die Weboberfläche (frontend/) ist NICHT enthalten –
# sie folgt erst, wenn der Server im Hintergrund feststeht (dann zweite Stufe oder getrenntes Image).
ARG GO_IMAGE=docker.io/library/golang:1.27
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-micro:latest

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/server ./cmd/server

FROM ${BASE_IMAGE}
# OpenShift startet mit zufälliger Benutzer-Id und Gruppe 0; es wird nirgends geschrieben (Schlüssel kommt aus ZP_SECRET_KEY).
COPY --from=build /out/server /usr/local/bin/server
USER 1001
ENV ZP_ADDR=:8080 ZP_PRODUCTION=1
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/server"]
CMD ["serve"]
