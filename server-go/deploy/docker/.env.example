# Kopieren nach .env und ausfüllen – nie ins Repository
POSTGRES_DB=zeitprotokoll
POSTGRES_USER=zeitprotokoll
POSTGRES_PASSWORD=CHANGEME_starkes_passwort

# mind. 32 Zeichen, im Tresor sichern – ohne ihn sind Tokens unlesbar
ZP_SECRET_KEY=CHANGEME_mindestens_32_zeichen_langer_schluessel

# Öffentliche Adresse (hinter TLS-Proxy: https://zeit.example.com)
ZP_PUBLIC_URL=http://127.0.0.1:8080
ZP_TZ=Europe/Berlin
# Lokal ohne TLS-Proxy: 1 · Hinter https-Proxy: 0 und ZP_TRUST_PROXY=1 setzen (dann Compose erweitern)
ZP_ALLOW_HTTP=1

# Nur localhost (sicher) – für LAN z. B. 0.0.0.0:8080 + Proxy davor
ZP_BIND=127.0.0.1:8080
