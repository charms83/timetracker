# /etc/zeitprotokoll/zeitprotokoll.env  (Rechte 0600, Besitzer zeitprotokoll) – nie ins Repository
DATABASE_URL=postgres://zeitprotokoll:CHANGEME@localhost:5432/zeitprotokoll?sslmode=disable
# Schlüssel für gespeicherte Tokens (mind. 32 Zeichen). Der Installer erzeugt ihn einmal; sichern (Tresor), nie ändern ohne Neuverschlüsselung.
ZP_SECRET_KEY=CHANGEME
# Öffentliche Adresse mit https (hinter einem Proxy mit TLS) – Pflicht
ZP_PUBLIC_URL=https://zeit.example.com
ZP_ADDR=127.0.0.1:8080
ZP_TZ=Europe/Berlin
# Ein Proxy (nginx/Apache/HAProxy) davor: Aufrufer-Adresse aus X-Forwarded-For
ZP_TRUST_PROXY=1
ZP_TRUSTED_PROXIES=1
ZP_PRODUCTION=1
# Weboberfläche (vom Paket mitgeliefert)
ZP_STATIC_DIR=/usr/share/zeitprotokoll/web
